# Porta su cui ascolta il server. La maggior parte degli host (Railway,
# Render, Fly.io) la impostano automaticamente: di solito non serve toccarla.
PORT=3001

# Domini ammessi per le richieste CORS/Socket.IO, separati da virgola.
# In locale si può lasciare vuota (si accetta qualsiasi origine).
# In produzione: il dominio del client su Vercel.
# CORS_ORIGIN=https://morichup.ivxn.dev,https://morichup.vercel.app
